{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: compilar Defensa Torres (cpp completo)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}/cpp/modelo",
                "-I${workspaceFolder}/cpp/estructuras",
                "-I${workspaceFolder}/cpp/gestor",
                "${workspaceFolder}/cpp/main.cpp",
                "${workspaceFolder}/cpp/gestor/*.cpp",
                "${workspaceFolder}/cpp/estructuras/*.cpp",
                "${workspaceFolder}/cpp/modelo/*.cpp",
                "-o",
                "${workspaceFolder}/cpp/defensa_torres.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cpp"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila TODO el proyecto C++ (main + gestor + estructuras + modelo) en cpp/defensa_torres.exe"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe compilar modulo",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${fileDirname}\\*.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compila solo los .cpp de la carpeta del archivo actual"
        }
    ]
}
